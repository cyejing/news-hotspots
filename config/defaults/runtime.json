{
  "pipeline": {
    "fetch_step_timeout_s": 900,
    "merge_timeout_s": 300,
    "hotspots_timeout_s": 120,
    "default_hotspots_top_n": 10,
    "archive_retention_days": 30
  },
  "fetch": {
    "rss": {
      "request_timeout_s": 20,
      "max_workers": 20,
      "max_articles_per_feed": 20,
      "retry_count": 1,
      "retry_delay_s": 3.0,
      "cache_ttl_hours": 1
    },
    "google": {
      "request_timeout_s": 20,
      "cooldown_s": 5.0,
      "results_per_query": 10
    },
    "twitter": {
      "request_timeout_s": 20,
      "cooldown_s": 5.0,
      "count": 20,
      "results_per_query": 10,
      "min_likes_search": 10
    },
    "zhihu": {
      "request_timeout_s": 30,
      "cooldown_s": 6.0,
      "limit": 20
    },
    "weibo": {
      "request_timeout_s": 30,
      "cooldown_s": 6.0,
      "limit": 30
    },
    "toutiao": {
      "request_timeout_s": 30,
      "cooldown_s": 6.0,
      "limit": 20
    },
    "xueqiu": {
      "request_timeout_s": 30,
      "cooldown_s": 6.0,
      "limit": 20
    },
    "api": {
      "request_timeout_s": 20,
      "max_workers": 10,
      "limit": 15,
      "host_cooldowns": {
        "api.weibo.cn": 1.0,
        "api.wallstreetcn.com": 1.0,
        "r.jina.ai": 1.0,
        "hacker-news.firebaseio.com": 1.0
      }
    }
  },
  "diagnostics": {
    "history_days": 7,
    "degraded_threshold": 0.5,
    "report_limit": 20,
    "error_text_limit": 180,
    "slow_request_thresholds_s": [
      3.0,
      5.0
    ],
    "title_filter": {
      "min_cjk_chars": 6,
      "min_word_tokens": 4
    },
    "log_pattern_keywords": {
      "timeout": [
        "timed out",
        "timeout",
        "超时"
      ],
      "rate_limited": [
        "429",
        "rate limit",
        "too many requests",
        "频次"
      ],
      "connection": [
        "connection",
        "refused",
        "reset",
        "unreachable",
        "dns",
        "连接"
      ],
      "parse": [
        "json",
        "decode",
        "parse",
        "解析"
      ],
      "empty": [
        "empty",
        "no results",
        "无结果",
        "no tweets",
        "no items"
      ]
    }
  },
  "cache": {
    "rss_cache_path": "/tmp/news-hotspots-rss-cache.json"
  },
  "_updated": "2026-10-30"
}